{
  "name": "example",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "cd .. && example/node_modules/.bin/jest --config example/package.json --rootDir example --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "detox:build:android:release": "detox build --configuration android.emu.release",
    "detox:test:android:release": "detox test --configuration android.emu.release"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "react-native-geckoview": "link:../"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/eslint-config": "^0.85.3",
    "@react-native/jest-preset": "^0.85.3",
    "@react-native/metro-config": "^0.85.3",
    "@react-native/typescript-config": "^0.85.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "detox": "^20.44.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "react-test-renderer": "19.2.6",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>",
      "<rootDir>/.."
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "testUtils.ts",
      "<rootDir>/e2e/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|react-native-geckoview)/)"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/node_modules/react-native",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-test-renderer$": "<rootDir>/node_modules/react-test-renderer",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1"
    },
    "collectCoverageFrom": [
      "<rootDir>/../src/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/../index.tsx",
      "!<rootDir>/../src/**/*.d.ts"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules/(?!react-native-geckoview)",
      "<rootDir>/../lib/",
      "<rootDir>/../node_modules/",
      "<rootDir>/../example/"
    ],
    "moduleDirectories": [
      "node_modules"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    },
    "coverageReporters": [
      "html",
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageDirectory": "<rootDir>/coverage"
  }
}
