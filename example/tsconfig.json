{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "allowJs": true,
    "noEmit": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "react",
      "jest",
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
