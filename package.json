{
  "name": "react-native-geckoview",
  "title": "React Native GeckoView",
  "version": "0.2.0",
  "description": "GeckoView component for React Native with Fabric support (Android-only)",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "index.tsx",
  "source": "index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./index.tsx",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/README.md",
    "android/src/main",
    "android/src/newarch",
    "lib",
    "src",
    "index.tsx",
    "react-native.config.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build": "yarn clean && yarn build:commonjs && yarn build:module && yarn build:types",
    "build:commonjs": "tsc -p tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:module": "tsc -p tsconfig.build.json --module esnext --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir lib/typescript",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint index.tsx src --ext .ts,.tsx",
    "test": "cd example && yarn test",
    "prepublishOnly": "yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dart-technologies/react-native-geckoview.git",
    "baseUrl": "https://github.com/dart-technologies/react-native-geckoview"
  },
  "keywords": [
    "react-native",
    "geckoview",
    "webview",
    "firefox",
    "android",
    "fabric"
  ],
  "author": {
    "name": "michow",
    "email": "hello@dart.art"
  },
  "license": "MIT",
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.85.0"
  },
  "codegenConfig": {
    "name": "GeckoViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnative.geckoview"
    }
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.85.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.20.0",
    "react": "19.2.6",
    "react-native": "0.85.3",
    "typescript": "~5.9.2"
  }
}
