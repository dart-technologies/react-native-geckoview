{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx"
  },
  "include": [
    "index.tsx",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "example",
    "lib",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
